classDiagram
    class Stall {
        +string id
        +string flapState
        +string presence
        +string bookedBy
    }

    class Booking {
        +string id
        +string userId
        +string vehicleId
        +string flapId
        +string state
        +int startTime
        +int expiry
        +int endTime
    }

    class Event {
        +string flapId
        +string action
        +int timestamp
    }

    class User {
        +string id
        +string name
    }

    class Vehicle {
        +string id
        +string ownerId
        +string plate
    }

    Stall "1" --> "0..1" Booking : bookedBy (the active one)
    Booking "many" --> "1" Stall : flapId (belongs to)
    Event "many" --> "1" Stall : flapId (logged against)
    User "1" --> "many" Vehicle : owns
    User "1" --> "many" Booking : userId
    Vehicle "1" --> "many" Booking : vehicleId
