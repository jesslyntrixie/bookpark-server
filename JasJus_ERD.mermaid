erDiagram
    STALL ||--o| BOOKING : "bookedBy (active)"
    STALL ||--o{ BOOKING : "flapId (history)"
    STALL ||--o{ EVENT : "flapId"
    USER ||--o{ VEHICLE : "owns"
    USER ||--o{ BOOKING : "userId"
    VEHICLE ||--o{ BOOKING : "vehicleId"

    STALL {
        string id PK
        string flapState
        string presence
        string bookedBy FK
    }

    BOOKING {
        string id PK
        string userId FK
        string vehicleId FK
        string flapId FK
        string state
        int startTime
        int expiry
        int endTime
    }

    EVENT {
        int id PK
        string flapId FK
        string action
        int timestamp
    }

    USER {
        string id PK
        string name
    }

    VEHICLE {
        string id PK
        string ownerId FK
        string plate
    }
