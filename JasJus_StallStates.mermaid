stateDiagram-v2
    note left of FREE
        Two raw fields decide everything:
        bookedBy (reservation, from HTTP)
        presence (car, from MQTT sensor)
        No stored "status" — it's derived.
    end note

    FREE : FREE
    FREE : bookedBy = null
    FREE : presence = free

    RESERVED : RESERVED (reserved, empty)
    RESERVED : bookedBy = set
    RESERVED : presence = free

    OCCUPIED : OCCUPIED (booked + car)
    OCCUPIED : bookedBy = set
    OCCUPIED : presence = occupied

    VIOLATION : VIOLATION (car, no booking)
    VIOLATION : bookedBy = null
    VIOLATION : presence = occupied

    [*] --> FREE

    FREE --> RESERVED : POST /book
    RESERVED --> FREE : POST /close  or  expiry
    RESERVED --> OCCUPIED : sensor: presence occupied
    OCCUPIED --> RESERVED : sensor: presence free
    OCCUPIED --> FREE : POST /close (car already left)

    FREE --> VIOLATION : sensor: car with no booking
    VIOLATION --> FREE : sensor: presence free
